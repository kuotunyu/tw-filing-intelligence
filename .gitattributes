# Keep LF in the working tree on every platform.
#
# This is not cosmetic: the frozen protocol is verified by SHA-256, and although
# `twfi.io.hashing.sha256_text_file` normalises newlines defensively, letting git
# rewrite line endings would still produce noisy diffs and confusing digests.
* text=auto eol=lf

*.py    text eol=lf diff=python
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.sql   text eol=lf

# Never touched by git anyway (see .gitignore), but be explicit.
*.pdf   binary
*.xbrl  binary
*.zip   binary
*.png   binary
*.jpg   binary
*.safetensors binary
*.gguf  binary
